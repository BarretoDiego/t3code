{
  "$schema": "../../schemas/package.schema.json",
  "name": "Claude Code with Kimi",
  "version": "1.0.0",
  "description": "An isolated Claude Code instance routed to Moonshot AI's Anthropic-compatible endpoint. Every Claude Code model tier is mapped to the chosen Kimi model.",
  "homepage": "https://platform.moonshot.ai/docs/guide/claude-code-kimi",
  "license": "MIT",
  "repository": "https://github.com/BarretoDiego/t3code",
  "publisher": "T3 Code",
  "type": "provider-template",
  "compatibility": {
    "t3": ">=0.0.1",
    "platforms": [
      "darwin",
      "linux",
      "win32"
    ]
  },
  "id": "claude-kimi",
  "payload": {
    "driver": "claudeAgent",
    "suggestedInstanceId": "claude_kimi",
    "displayName": "Claude · Kimi",
    "accentColor": "#000000",
    "icon": "kimi",
    "inputs": [
      {
        "id": "api-key",
        "label": "Kimi API key",
        "description": "Created at platform.kimi.ai. Stored encrypted by the environment and passed only to Claude Code processes.",
        "control": "password",
        "required": true,
        "placeholder": "sk-…"
      },
      {
        "id": "model",
        "label": "Model",
        "description": "Applied to every Claude Code model tier (main, background, and sub-agents). Try kimi-k2.7-code-highspeed for faster coding output.",
        "control": "text",
        "required": true,
        "default": "kimi-k3[1m]",
        "placeholder": "kimi-k3[1m]"
      },
      {
        "id": "compact-window",
        "label": "Auto-compact window",
        "description": "Context size in tokens that triggers auto-compaction. 1048576 for kimi-k3[1m]; 262144 for 256K models such as kimi-k2.7-code.",
        "control": "text",
        "required": true,
        "default": "1048576",
        "placeholder": "1048576"
      }
    ],
    "config": {
      "customModels": [
        "{{input.model}}"
      ]
    },
    "environment": [
      {
        "name": "ANTHROPIC_AUTH_TOKEN",
        "input": "api-key",
        "sensitive": true,
        "required": true
      },
      {
        "name": "ANTHROPIC_BASE_URL",
        "value": "https://api.moonshot.ai/anthropic",
        "sensitive": false,
        "required": true
      },
      {
        "name": "ANTHROPIC_MODEL",
        "value": "{{input.model}}",
        "sensitive": false,
        "required": true
      },
      {
        "name": "ANTHROPIC_DEFAULT_OPUS_MODEL",
        "value": "{{input.model}}",
        "sensitive": false,
        "required": true
      },
      {
        "name": "ANTHROPIC_DEFAULT_SONNET_MODEL",
        "value": "{{input.model}}",
        "sensitive": false,
        "required": true
      },
      {
        "name": "ANTHROPIC_DEFAULT_HAIKU_MODEL",
        "value": "{{input.model}}",
        "sensitive": false,
        "required": true
      },
      {
        "name": "ANTHROPIC_DEFAULT_FABLE_MODEL",
        "value": "{{input.model}}",
        "sensitive": false,
        "required": true
      },
      {
        "name": "CLAUDE_CODE_SUBAGENT_MODEL",
        "value": "{{input.model}}",
        "sensitive": false,
        "required": true
      },
      {
        "name": "CLAUDE_CODE_AUTO_COMPACT_WINDOW",
        "value": "{{input.compact-window}}",
        "sensitive": false,
        "required": true
      },
      {
        "name": "CLAUDE_CODE_EFFORT_LEVEL",
        "value": "max",
        "sensitive": false,
        "required": false
      }
    ],
    "providerHome": {
      "configField": "homePath",
      "files": []
    }
  },
  "permissions": [
    "provider.configure",
    "provider.environment",
    "provider.files"
  ],
  "schemaVersion": 1
}
