{
  "$schema": "../../schemas/package.schema.json",
  "name": "Claude Code with DeepSeek",
  "version": "1.0.0",
  "description": "An isolated Claude Code instance routed to DeepSeek's Anthropic-compatible endpoint. Main tiers use the pro model; the background tier uses flash.",
  "homepage": "https://api-docs.deepseek.com/quick_start/agent_integrations/claude_code",
  "license": "MIT",
  "repository": "https://github.com/BarretoDiego/t3code",
  "publisher": "T3 Code",
  "type": "provider-template",
  "compatibility": {
    "t3": ">=0.0.1",
    "platforms": [
      "darwin",
      "linux",
      "win32"
    ]
  },
  "id": "claude-deepseek",
  "payload": {
    "driver": "claudeAgent",
    "suggestedInstanceId": "claude_deepseek",
    "displayName": "Claude · DeepSeek",
    "accentColor": "#4D6BFE",
    "icon": "deepseek",
    "inputs": [
      {
        "id": "api-key",
        "label": "DeepSeek API key",
        "description": "Created at platform.deepseek.com. Stored encrypted by the environment and passed only to Claude Code processes.",
        "control": "password",
        "required": true,
        "placeholder": "sk-…"
      },
      {
        "id": "model",
        "label": "Model",
        "description": "Used for the main conversation and the opus/sonnet tiers.",
        "control": "text",
        "required": true,
        "default": "deepseek-v4-pro[1m]",
        "placeholder": "deepseek-v4-pro[1m]"
      },
      {
        "id": "fast-model",
        "label": "Fast model",
        "description": "Used for the haiku tier and sub-agents (background titles, summaries).",
        "control": "text",
        "required": true,
        "default": "deepseek-v4-flash",
        "placeholder": "deepseek-v4-flash"
      },
      {
        "id": "compact-window",
        "label": "Auto-compact window",
        "description": "Context size in tokens that triggers auto-compaction.",
        "control": "text",
        "required": true,
        "default": "786432",
        "placeholder": "786432"
      }
    ],
    "config": {
      "customModels": [
        "{{input.model}}",
        "{{input.fast-model}}"
      ]
    },
    "environment": [
      {
        "name": "ANTHROPIC_AUTH_TOKEN",
        "input": "api-key",
        "sensitive": true,
        "required": true
      },
      {
        "name": "ANTHROPIC_BASE_URL",
        "value": "https://api.deepseek.com/anthropic",
        "sensitive": false,
        "required": true
      },
      {
        "name": "ANTHROPIC_MODEL",
        "value": "{{input.model}}",
        "sensitive": false,
        "required": true
      },
      {
        "name": "ANTHROPIC_DEFAULT_OPUS_MODEL",
        "value": "{{input.model}}",
        "sensitive": false,
        "required": true
      },
      {
        "name": "ANTHROPIC_DEFAULT_SONNET_MODEL",
        "value": "{{input.model}}",
        "sensitive": false,
        "required": true
      },
      {
        "name": "ANTHROPIC_DEFAULT_HAIKU_MODEL",
        "value": "{{input.fast-model}}",
        "sensitive": false,
        "required": true
      },
      {
        "name": "CLAUDE_CODE_SUBAGENT_MODEL",
        "value": "{{input.fast-model}}",
        "sensitive": false,
        "required": true
      },
      {
        "name": "CLAUDE_CODE_EFFORT_LEVEL",
        "value": "max",
        "sensitive": false,
        "required": false
      },
      {
        "name": "CLAUDE_CODE_AUTO_COMPACT_WINDOW",
        "value": "{{input.compact-window}}",
        "sensitive": false,
        "required": true
      }
    ],
    "providerHome": {
      "configField": "homePath",
      "files": []
    }
  },
  "permissions": [
    "provider.configure",
    "provider.environment",
    "provider.files"
  ],
  "schemaVersion": 1
}
