{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://t3.codes/schemas/marketplace/v1.json",
  "title": "T3 Code Marketplace v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "packages"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "homepage": { "type": "string", "minLength": 1 },
    "packages": {
      "type": "array",
      "items": { "$ref": "#/$defs/package" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "name", "version", "description", "manifest"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "description": { "type": "string", "minLength": 1 },
        "manifest": { "type": "string", "minLength": 1 },
        "integrity": { "type": "string", "pattern": "^sha256-[0-9a-f]{64}$" },
        "publisher": { "type": "string", "minLength": 1 },
        "icon": { "type": "string", "minLength": 1 },
        "tags": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "permissions": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" }
        },
        "compatibility": { "$ref": "#/$defs/compatibility" }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "t3": { "type": "string", "minLength": 1 },
        "platforms": {
          "type": "array",
          "items": { "enum": ["darwin", "linux", "win32"] }
        }
      }
    }
  }
}
